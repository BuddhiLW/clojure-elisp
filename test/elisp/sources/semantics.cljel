(ns semantics
  "Everyday Clojure, compiled and then run: the fixture behind
   test/elisp/clojure-elisp-semantics-test.el.")

;;; Function values

(def doubler (fn [x] (* 2 x)))

(defn call-param [f x] (f x))

(defn call-let-bound [] (let [f inc] (f 1)))

(defn call-def-value [] (doubler 21))

(defn call-computed [] ((comp inc inc) 1))

(defn call-var-quote [] (#'inc 1))

(defn pass-core-fn [] (call-param inc 41))

(defn letfn-value [] (letfn [(twice [x] (* 2 x))] (map twice [1 2])))

(defn letfn-param-shadows [] (letfn [(g [x] x) (f [g] (g 5))] (f inc)))

;;; Keywords and maps in function position

(defn kw-get [m] (:k m))

(defn kw-default [m] (:k m :none))

(defn map-as-fn [] ({:a 1} :a))

;;; Keywords, maps and sets as function arguments

(def phases [{:id :night :elev -18} {:id :golden :elev 6} {:id :civil :elev -6}])

(defn kw-map [] (map :id phases))

(defn kw-sort-by [] (map :id (sort-by :elev phases)))

(defn kw-sort-by-desc [] (map :id (sort-by :elev > phases)))

(defn kw-filter [] (filter :on [{:on true :n 1} {:n 2} {:on 1 :n 3}]))

(defn kw-group-by [] (group-by :kind [{:kind :a :n 1} {:kind :b :n 2} {:kind :a :n 3}]))

(defn set-as-pred [] (filter #{:a :c} [:a :b :c :d]))

(defn map-as-mapper [] (map {:a 1 :b 2} [:a :b :z]))

;;; Comparators and sorting

(defn sort-default [] (sort [3 1 2]))

(defn sort-lt [] (sort < [3 1 2]))

(defn sort-gt [] (sort > [3 1 2]))

(defn sort-compare [] (sort compare ["b" "a" "c"]))

(defn sort-reverse-compare [] (sort (fn [a b] (compare b a)) [1 3 2]))

(defn sort-keywords [] (sort [:b :c :a]))

(defn compare-values [] [(compare 1 2) (compare "b" "a") (compare :a :a) (compare nil 1)])

;;; Extra function arguments

(defn swap-update []
  (let [a (atom {:count 1})]
    (swap! a update :count inc)
    (swap! a update :count + 10)
    @a))

(defn update-extra-args [] (update {:a 1} :a + 10))

;;; Destructuring in iteration bindings

(defn doseq-pairs []
  (let [acc (atom [])]
    (doseq [[a b] [[1 2] [3 4]]] (swap! acc conj (+ a b)))
    @acc))

(defn doseq-map-entries []
  (let [acc (atom [])]
    (doseq [[k v] {:a 1 :b 2}] (swap! acc conj [k v]))
    @acc))

(defn for-pairs [] (for [[a b] [[1 2] [3 4]] :let [[c] [(* a b)]]] (+ c 1)))

(defn for-map-entries [] (for [[k v] {:x 10 :y 20} :when (> v 10)] k))

(defn loop-rest [xs] (loop [[x & more] xs acc 0] (if x (recur more (+ acc x)) acc)))

(defn map-fn-entries [] (map (fn [[k v]] [v k]) {:a 1 :b 2}))

;;; Destructuring shorter collections

(defn short-vector [] (let [[a b c] [1 2]] [a b c]))

(defn short-rest [] (let [[a & [b]] [1]] [a b]))

(defn rest-of-lazy [] (let [[a & more] (map inc [1 2 3])] [a more]))

(defn nested-map-destructure [m] (let [{[x y] :pt {:keys [z]} :inner} m] [x y z]))

;;; Definitions: defonce, private names, assignment

(defonce registry "Registered things." (atom []))

(defonce ^{:doc "Loaded once."} loads 0)

(def ^:private secret 42)

(defn ^:private meta-private [x] (+ x secret))

(defn- dash-private [x] (* 2 x))

(defn call-privates [] [(meta-private 1) (dash-private 2) (semantics/meta-private 3) (map dash-private [5])])

(def counter 0)

(defn bump-counter [] (setq counter (inc counter)) (set! counter (+ counter 10)) counter)

;;; Maps

(defn map-equality []
  [(= {:a 1 :b 2} {:b 2 :a 1})
   (= (assoc {:a 1} :b 2) {:a 1 :b 2})
   (= {:a {:x [1 2]}} {:a {:x [1 2]}})
   (= {:a 1} {:a 2})
   (= {:a 1} {:a 1 :b 2})
   (not= {:a 1} {:a 1})
   (= [1 2 3] (map identity [1 2 3]))
   (= [[1 2] [3 4]] [[3 4] [1 2]])
   (= 1 1 1)])

(defn map-contains []
  [(contains? {:colors [1 2]} :colors)
   (contains? {:a nil} :a)
   (contains? {:a {:b 1}} :a)
   (contains? {:a 1} :z)
   (contains? #{:a :b} :a)
   (contains? #{[1 2]} [1 2])])

(defn integer-keys []
  (let [months {1 :jan 2 :feb 12 :dec}]
    [(get months 1) (get months 12) (get months 3 :none) (get [10 20 30] 1) (get [[1 2] [3 4]] 1)]))

(defn into-map []
  [(into {} [[:a 1] [:b 2]])
   (into {:z 0} {:a 1})
   (into {} (map (fn [[k v]] [k (inc v)]) {:a 1 :b 2}))
   (conj {:a 1} [:b 2])])

(defn assoc-many [] (assoc {:a 1} :b 2 :c 3 :a 10))

(defn assoc-vector [] [(assoc [1 2 3] 1 :x) (assoc [1 2] 2 3)])

(defn dissoc-many [] (dissoc {:a 1 :b 2 :c 3} :a :c))

(defn list-valued-entries []
  (let [looks {:night {:theme :dark} :day {:theme :light :wall "d.png"} :tags [:x]}]
    (for [[k v] looks] [k v])))

(defn entry-accessors []
  (let [e (first {:a [1 2]})]
    [(key e) (val e) (count e) (second e) (nth e 1) (rest e)]))

(defn reduce-entries [] (reduce (fn [acc [k v]] (+ acc v)) 0 {:a 1 :b 2 :c 3}))

(defn map-predicates []
  [(map? {:a 1}) (map? {:a [1]}) (map? [1 2]) (map? [[1 2]]) (map? nil)
   (vector? [1 2]) (vector? {:a 1}) (vector? [[:a 1]])])

(defn hash-map-builds-a-map [] (let [m (hash-map :a 1 :b [2])] [(map? m) (get m :b) (= m {:b [2] :a 1})]))

(defn zipmap-and-friends []
  [(zipmap [:a :b :a] [1 2 3])
   (frequencies [:x :y :x])
   (select-keys {:a 1 :b 2 :c 3} [:a :c])
   (merge {:a 1 :b 2} {:b 3 :c 4})])

(defn quoted-map [] '{:k v})

(defn empty-string-empty [] [(empty? "") (empty? "a") (not-empty "") (not-empty [1])])

;;; Core functions

(defn realized-seqs []
  [(mapv inc [1 2]) (vec (list 1 2)) (vec (first {:a [1 2]})) (filterv odd? [1 2 3])
   (map-indexed (fn [i x] [i x]) [:a :b])])

(defn extreme-keys []
  [(:id (apply min-key :elev phases)) (max-key count "a" "abc" "ab") (min-key abs -3 2 -1)])

(defn names-and-keywords []
  [(name :night) (name 'sym) (name "s") (name (keyword "ns" "n")) (namespace (keyword "ns" "n"))
   (keyword "night") (keyword "ns" "n") (keyword :k) (symbol "x") (str :night)])

(defn coercions [] [(int 3.7) (int -3.7) (boolean nil) (boolean 0) (integer? 3) (float? 3.0) (identical? :a :a)])

(defn not-equal-generic [] [(not= nil 1) (not= {:a 1} {:a 1}) (not= "a" "b")])

(defn exceptions []
  [(try (throw (ex-info "neg" {:x -1})) (catch :default e [(ex-message e) (ex-data e)]))
   (try (error "boom %d" 1) (catch :default e [(ex-message e) (ex-data e)]))])

(defn parsing [] [(parse-long "42") (parse-long "-7") (parse-long "4.2") (parse-long "x") (parse-double "2.5")])

(defn math []
  [(Math/floor 2.7) (Math/ceil 2.1) (Math/round 2.5) (Math/round -2.5) (Math/pow 2 10)
   (Math/abs -3) (Math/sqrt 16) (Math/max 1 5) (> Math/PI 3.14) (Math/signum -2) (Math/log10 1000)])
