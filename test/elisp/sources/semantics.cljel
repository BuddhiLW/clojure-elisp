(ns semantics
  "Everyday Clojure, compiled and then run: the fixture behind
   test/elisp/clojure-elisp-semantics-test.el.")

;;; Function values

(def doubler (fn [x] (* 2 x)))

(defn call-param [f x] (f x))

(defn call-let-bound [] (let [f inc] (f 1)))

(defn call-def-value [] (doubler 21))

(defn call-computed [] ((comp inc inc) 1))

(defn call-var-quote [] (#'inc 1))

(defn pass-core-fn [] (call-param inc 41))

(defn letfn-value [] (letfn [(twice [x] (* 2 x))] (map twice [1 2])))

(defn letfn-param-shadows [] (letfn [(g [x] x) (f [g] (g 5))] (f inc)))

;;; Keywords and maps in function position

(defn kw-get [m] (:k m))

(defn kw-default [m] (:k m :none))

(defn map-as-fn [] ({:a 1} :a))

;;; Keywords, maps and sets as function arguments

(def phases [{:id :night :elev -18} {:id :golden :elev 6} {:id :civil :elev -6}])

(defn kw-map [] (map :id phases))

(defn kw-sort-by [] (map :id (sort-by :elev phases)))

(defn kw-sort-by-desc [] (map :id (sort-by :elev > phases)))

(defn kw-filter [] (filter :on [{:on true :n 1} {:n 2} {:on 1 :n 3}]))

(defn kw-group-by [] (group-by :kind [{:kind :a :n 1} {:kind :b :n 2} {:kind :a :n 3}]))

(defn set-as-pred [] (filter #{:a :c} [:a :b :c :d]))

(defn map-as-mapper [] (map {:a 1 :b 2} [:a :b :z]))

;;; Comparators and sorting

(defn sort-default [] (sort [3 1 2]))

(defn sort-lt [] (sort < [3 1 2]))

(defn sort-gt [] (sort > [3 1 2]))

(defn sort-compare [] (sort compare ["b" "a" "c"]))

(defn sort-reverse-compare [] (sort (fn [a b] (compare b a)) [1 3 2]))

(defn sort-keywords [] (sort [:b :c :a]))

(defn compare-values [] [(compare 1 2) (compare "b" "a") (compare :a :a) (compare nil 1)])

;;; Extra function arguments

(defn swap-update []
  (let [a (atom {:count 1})]
    (swap! a update :count inc)
    (swap! a update :count + 10)
    @a))

(defn update-extra-args [] (update {:a 1} :a + 10))

;;; Destructuring in iteration bindings

(defn doseq-pairs []
  (let [acc (atom [])]
    (doseq [[a b] [[1 2] [3 4]]] (swap! acc conj (+ a b)))
    @acc))

(defn doseq-map-entries []
  (let [acc (atom [])]
    (doseq [[k v] {:a 1 :b 2}] (swap! acc conj [k v]))
    @acc))

(defn for-pairs [] (for [[a b] [[1 2] [3 4]] :let [[c] [(* a b)]]] (+ c 1)))

(defn for-map-entries [] (for [[k v] {:x 10 :y 20} :when (> v 10)] k))

(defn loop-rest [xs] (loop [[x & more] xs acc 0] (if x (recur more (+ acc x)) acc)))

(defn map-fn-entries [] (map (fn [[k v]] [v k]) {:a 1 :b 2}))

;;; Destructuring shorter collections

(defn short-vector [] (let [[a b c] [1 2]] [a b c]))

(defn short-rest [] (let [[a & [b]] [1]] [a b]))

(defn rest-of-lazy [] (let [[a & more] (map inc [1 2 3])] [a more]))

(defn nested-map-destructure [m] (let [{[x y] :pt {:keys [z]} :inner} m] [x y z]))

;;; Definitions: defonce, private names, assignment

(defonce registry "Registered things." (atom []))

(defonce ^{:doc "Loaded once."} loads 0)

(def ^:private secret 42)

(defn ^:private meta-private [x] (+ x secret))

(defn- dash-private [x] (* 2 x))

(defn call-privates [] [(meta-private 1) (dash-private 2) (semantics/meta-private 3) (map dash-private [5])])

(def counter 0)

(defn bump-counter [] (setq counter (inc counter)) (set! counter (+ counter 10)) counter)
